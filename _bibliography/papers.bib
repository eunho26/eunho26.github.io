@article{glove2024sung,
  abbr={Haptic},
  bibtex_show={true},
  title={SNU-Avatar Haptic Glove: Novel Modularized Haptic Glove via Trigonometric Series Elastic Actuators},
  abstract = {The avatar robot is a robot capable of realistic remote operation, where the controllability of the glove is crucial. The glove manipulates the hand that directly interacts with the environment at the remote site, requiring accurate estimation of hand posture and haptic feedback to convey environmental information and enhance operability, all while minimizing user discomfort. To address this need, this research proposes providing force feedback to the fingers using Trigonometric Series Elastic Actuators. The haptic glove is attached to the middle phalanx to allow easy installation of additional add-ons and ensure a secure fit for the user. Furthermore, an algorithm is proposed to estimate the fingertip position without directly attaching sensors to the fingertip, enabling the glove to estimate hand posture and deliver appropriate force. The complete system, including the haptic glove, participated in the ANA Avatar XPRIZE competition. The avatar system successfully performed eight missions, involving both remote manipulation tasks and social interactions, demonstrating its effectiveness.},
  author={Sung, Eunho and You, Seungbin and Seongkyeong Moon and Juhyun Kim and Jaeheung Park},
  journal={2024 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  video={https://www.youtube.com/embed/tGXdiD0JgZ8?si=oSLegHga_d3J_wbb},
  year={2024},
  publisher={IEEE},
  preview={glove.gif},
  pages={3573-3580},
  doi={10.1109/IROS58592.2024.10802590},
  selected={true},
  pdf={example_pdf.pdf},
}


@article{glove2024sung,
  abbr={Haptic},
  bibtex_show={true},
  title={SNU-Avatar Haptic Glove: Novel Modularized Haptic Glove via Trigonometric Series Elastic Actuators},
  abstract = {The avatar robot is a robot capable of realistic remote operation, where the controllability of the glove is crucial. The glove manipulates the hand that directly interacts with the environment at the remote site, requiring accurate estimation of hand posture and haptic feedback to convey environmental information and enhance operability, all while minimizing user discomfort. To address this need, this research proposes providing force feedback to the fingers using Trigonometric Series Elastic Actuators. The haptic glove is attached to the middle phalanx to allow easy installation of additional add-ons and ensure a secure fit for the user. Furthermore, an algorithm is proposed to estimate the fingertip position without directly attaching sensors to the fingertip, enabling the glove to estimate hand posture and deliver appropriate force. The complete system, including the haptic glove, participated in the ANA Avatar XPRIZE competition. The avatar system successfully performed eight missions, involving both remote manipulation tasks and social interactions, demonstrating its effectiveness.},
  author={Sung, Eunho and You, Seungbin and Seongkyeong Moon and Juhyun Kim and Jaeheung Park},
  journal={2024 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  video={https://www.youtube.com/embed/tGXdiD0JgZ8?si=oSLegHga_d3J_wbb},
  year={2024},
  publisher={IEEE},
  preview={glove.gif},
  pages={3573-3580},
  doi={10.1109/IROS58592.2024.10802590},
  selected={true},
  pdf={example_pdf.pdf},
}

@article{hand2024sung,
  abbr={RobotHand},
  bibtex_show={true},
  title={SNU-Avatar Robot Hand: Dexterous Robot Hand with Prismatic Four-Bar Linkage for Versatile Daily Applications},
  abstract = {This paper presents an innovative approach to designing a robot hand specifically tailored for the final round of the ANA Avatar XPRIZE Challenge, a teleoperation robot competition. The primary objective of the hand is to replicate a person's remote actions, gestures, emotional expressions, and everyday object manipulation, including tool use. To enable finger flexion--extension (FE) with a single linear actuator, multiple four-bar linkage mechanisms are employed for the FE joints. Additionally, compliant elements are integrated through adduction--abduction (AA) joints with a timing-belt pulley system and springs accompanying the FE joints, allowing effortless grasping of objects with unknown shapes. As a result, a four-fingered, eight-degree-of-freedom hand is developed, achieving robust fingertip grip while minimizing weight to preserve the robot arm's payload capacity. This paper describes the hand's kinematic design process, presents FEM analysis results evaluating structural robustness and potential plastic deformation, and reports taxonomy analysis derived from real grasping experiments.},
  author={Sung, Eunho and You, Seungbin and Kim, Seungyeon and Jaeheung Park},
  journal={2023 IEEE-RAS 22nd International Conference on Humanoid Robots (Humanoids)},
  video={https://www.youtube.com/embed/qNxD-JU64iA?si=8ROPU-yIaH1_nz7n},
  year={2023},
  publisher={IEEE},
  pages={1-8},
  selected={true},
  doi={10.1109/Humanoids57100.2023.10375222},
  preview={finger.gif},
}


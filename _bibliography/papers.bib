@article{Luta2026byun,
  abbr={RobotHand},
  bibtex_show={true},
  title={The LUTA Hand: Development of a Lightweight Underactuated Three-fingered Robotic Hand for Adaptive Grasping},
  abstract = {Robotic hands are central to a wide range of manipulation tasks, enabling human-like dexterity and adaptability. However, achieving such functionality with minimal actuation and reduced mechanical complexity remains a key challenge. Conventional approaches often rely on complex actuation mechanisms, resulting in increased system weight and limited integration flexibility. This study presents a lightweight, underactuated three-fingered robotic hand that incorporates tendon-driven actuation and compliant joint structures. A shared tendon-routing scheme enables synchronized finger flexion with a single actuator, while passive restoring forces are provided by rolling contact joints and elastic ligaments, removing the need for antagonistic actuation. All actuation components are embedded within the hand, resulting in a compact and portable configuration. Experimental evaluations demonstrate consistent finger motion, passive adaptation to varying object geometries, and the ability to perform multiple types of grasps with an underactuated architecture. These findings indicate the potential of the proposed design to serve as an efficient and compact solution for robotic manipulation.},
  author={Byun, Seunghwan and Moon, Seongkyeong and Sung, Eunho and You, Seungbin and Park, Yong-Lae and Park, Jaeheung},
  journal={International Journal of Control, Automation and Systems},
  year={2025},
  publisher={Springer Nature},
  preview={Pub_Th_Luta1.jpg},
  video = {https://www.youtube.com/embed/4lZAEqe81P0},
  doi={https://doi.org/10.1007/s12555-025-0545-0}
}

@article{Semi2025you,
  abbr={Reducer},
  bibtex_show={true},
  title={Semidirect Drive Based on Tri-Contacted Plate Harmonic Reducer},
  abstract = {Robotic actuators face a performance gap between low-ratio quasi-direct drive (QDD) systems and conventional harmonic drives, which are typically limited to ratios above 30:1. This article presents a tri-contacted plate harmonic reducer (Tri-c PHR) that addresses this challenge by combining axial elastic deformation with a three-point tooth engagement system. The proposed design achieves a 16:1 reduction ratio—a range where conventional harmonic gears face significant design challenges—while maintaining high efficiency and low backlash. An initial prototype validates the design’s feasibility, demonstrating competitive positioning accuracy and backdrivability comparable to commercial harmonic reducers, despite operating at a significantly lower reduction ratio. The Tri-c PHR offers a compelling solution for applications requiring both torque transparency and moderate reduction ratios.},
  author={You, Seungbin and Sung, Eunho and Kim, Dongjun and Kim, Juhyun and Park, Jaeheung},
  journal={IEEE/ASME Transactions on Mechatronics}, 
  year={2025},
  doi={10.1109/TMECH.2025.3628311},
  selected={true},
  preview={Pub_Th_SemiD.png},
  publisher={IEEE}
}

@article{Luta2025byun,
  abbr={RobotHand},
  bibtex_show={true},
  title={The LUTA Hand: A Lightweight Underactuated Three-Fingered Robotic Hand for Adaptive Grasping},
  abstract = {This paper presents the design and evaluation of the LUTA Hand, a lightweight, underactuated, three-fingered robotic hand capable of adaptive grasping. The hand employs a shared tendon-routing scheme to coordinate flexion of three fingers using a single actuator, while rolling contact joints and elastic ligaments provide passive restoring forces, eliminating the need for antagonistic actuation. Experimental results demonstrate consistent finger movement, fingertip force, and grasping a range of objects and shapes, enabled by the adaptive grasping capability. These findings highlight the potential of combining minimal actuation with compliant mechanisms for efficient and versatile robotic hands.},
  author={Byun, Seunghwan and Moon, Seongkyeong and Sung, Eunho and You, Seungbin and Park, Yong-Lae and  Park, Jaeheung},
  journal={2025 25th International Conference on Control, Automation and Systems (ICCAS)},
  preview={Pub_Th_Luta2.png},
  year={2025},
  publisher={IEEE}
}

@article{11128660,
  abbr={State Estimation},
  bibtex_show={true},
  author={Lee, Haeseong and Sung, Eunho and You, Seungbin and Park, Jaeheung},
  journal={2025 IEEE International Conference on Robotics and Automation (ICRA)}, 
  abstract = {For successful peg-in-hole assembly, predefined sub-tasks should be executed sequentially according to the current contact state. Therefore, recognizing contact state transitions is essential in order to determine whether to continue the current task or proceed to the next. Learning-based solutions have shown outstanding results in this context; however, these methods heavily rely on balanced datasets, which are challenging to obtain due to the short duration of certain contact states and rare failure cases. To address this issue, this paper proposes a framework for estimating contact state transitions using anomaly detection through input data reconstruction. The proposed framework operates in a semisupervised manner, eliminating the need for balanced datasets during training. For input data reconstruction, a convolutional neural network is combined with a variational autoencoder to process various sensor measurements as a multivariate time series. Unlike traditional binary anomaly detection, the proposed anomaly detector evaluates reconstruction errors and leverages domain knowledge to identify diverse contact state transitions in peg-in-hole assembly. The effectiveness of the proposed framework is validated through experiments using a torque-controlled dual manipulator system.},
  title={CC-STAR: An Estimation for Contact State Transition Using Reconstruction-Based Anomaly Detection for Peg-in-Hole Assembly}, 
  year={2025},
  pages={15486-15492},
  organization={IEEE},
  video = {https://www.youtube.com/embed/KiOeqzglVig},
  doi={10.1109/ICRA55743.2025.11128660}
}

@article{arm2025park,
  abbr={Mechanism},
  bibtex_show={true},
  title={Novel Layered Multi Angular Gearless Transmission (L-MAGT) Mechanism for Agile Manipulation},
  abstract = {This paper introduces a multi-axis power transfer mechanism that is applicable when actuators and their corresponding joints are placed separately in a manipulator. In particular, the humanoid arm is considered the primary target of application. A modified Hobson joint, termed the Multi Angular Gearless Transmission (MAGT), serves as the central mechanism. The system transmits power through the elbow to the wrist without requiring direct placement of the actuator in the distal part of the manipulator. The design uses a layered MAGT (L-MAGT) to convey coaxial inputs. In this study, L-MAGT employing three layers is applied to implement a wrist with three axes. After L-MAGT transmits inputs, the coupled wrist structure converts them into roll, yaw, and pitch motions of the wrist. This approach reduces the weight of the actuator in the distal part of the manipulator, leading to more agile manipulation. Furthermore, the MAGT ensures constant velocity transmission across varying elbow angles, eliminating the velocity fluctuation typically associated with universal joints, such as the Cardan joint. Experimental validation using a 3D printed prototype and a motion capture system shows that the mechanism achieves its intended range of motion and maintains acceptable repeatability, despite some backlash and compliance introduced by 3D printed components. The results confirm the feasibility of this mechanism for humanoid arms and manipulators. The proposed mechanism, which passes through a joint with variable angles, offers a novel multi-axis power transfer solution for manipulator design.},
  author={Park, Jooyoung and Sung, Eunho and You, Seungbin and Kim, Juhyun and Byun, Seunghwan and Kim, Dongjun and Park, Jaeheung},
  journal={2025 22nd International Conference on Ubiquitous Robots (UR)},
  pages={418-425},
  year={2025},
  doi={10.1109/UR65550.2025.11078132},
  preview={Pub_Th_MAGT.png},
  video = {https://www.youtube.com/embed/6WzPbdK2mgg},
  publisher={IEEE}
}

@article{avatar2025park,
  abbr={Avatar},
  bibtex_show={true},
  title={Intuitive and Interactive Robotic Avatar System for Tele-Existence: TEAM SNU in the ANA Avatar XPRIZE Finals},
  abstract = {Avatar robots enable the teleoperation and telepresence of an operator with a rich and meaningful sense of existence in another location. Robotic avatar systems rely on intuitive interactions to afford operators comfortable and accurate robot control to perform various tasks. The ability of operators to feel immersed within a robot has drawn interest in multiple research fields to explore the future capabilities of such systems. This paper presents a robotic avatar system based on a custom humanoid robot, TOCABI, with a mobile base. Its teleoperation system was developed in response to the ANA Avatar XPRIZE. Combining the life-size humanoid robot and the mobile base allows for improved mobility and dexterous manipulation. The robotic avatar system comprises the robot/base and an operator station that incorporates haptic feedback devices, trackers, a head-mounted display, gloves, and pedals. These devices connect the robot-environment interaction and operator-avatar robot experience through visual, auditory, tactile, haptic, and kinesthetic feedback. Combining the untethered battery-operated and Wi-Fi-enabled robot with these sensory experiences enables intuitive control through the operator’s body movement. The performance of the robotic avatar system was evaluated through user studies and demonstrated in the ANA Avatar XPRIZE Finals, represented by Team SNU, where it completed 8 of the 10 missions, placing the team eighth among the 17 finalists.},
  author={Beomyeong Park and Donghyeon Kim and Daegyu Lim and Suhan Park and Junewhee Ahn and Seungyeon Kim and Jaeyong Shink and Sung, Eunho and Jaehoon Sim and Junhyung Kim and Myeong-Ju Kim and Junhyeok Cha and Gyeongjae Park and Hokyun Lee and You, Seungbin and  Keunwoo Jang and Seung-Hun Kim and Mathew Schwartz and Jaeheung Park},
  journal={International Journal of Social Robotics},
  year={2025},
  selected={true},
  publisher={Springer Nature},
  preview={Pub_Th_Avatar_Final.png},
  doi={https://doi.org/10.1007/s12369-024-01152-y}
}

@article{wearable2024lee,
  abbr={Wearable},
  bibtex_show={true},
  title={Development of Neutral Zone-based Lumbar Support Robotic Device Utilizing an Electroadhesive Clutch},
  abstract = {This research introduces a lightweight and energy-efficient lumbar support robotic device aimed at reducing low back pain (LBP) in elderly and physically weak individuals. The device employs an electroadhesive clutch, significantly reducing energy consumption and weight compared to conventional actuators. Using an inertial measurement unit (IMU), the robotic system dynamically adjusts support according to the user’s lumbar motion by regulating intra-abdominal pressure (IAP) to enhance spinal stability. The neutral zone (NZ) concept is applied to ensure that the clutch remains disengaged within the NZ where support is unnecessary and engages outside the NZ to provide appropriate assistance. Experiments conducted using a dummy model that mimics human lumbar motion demonstrate the device’s ability to modulate abdominal pressure and deliver adaptive lumbar support, indicating its potential as an effective alternative to conventional lumbar braces.},
  author={Lee, Garam and Sung, Eunho and Kim, Joowan and Park, Jaeheung and Kim, Keewon},
  journal={2024 24th International Conference on Control, Automation and Systems (ICCAS)},
  doi={10.23919/ICCAS63016.2024.10773219},
  pages={184-186},
  year={2024},
  award      = {https://2024.iccas.org/?page_id=988}, 
  award_name={Outstanding Student Paper Award},
  publisher={IEEE}
}

@article{wearable2025lee,
  abbr={Wearable},
  bibtex_show={true},
  title={Development of Neutral Zone-based Lumbar Support Wearable Robot Utilizing an Electroadhesive Clutch},
  abstract = {This paper presents the development of an ultra-lightweight and ultra-low-power lumbar support robotic device designed to alleviate low back pain (LBP) in elderly and physically weak individuals. The device employs an electroadhesive clutch, enabling significant reductions in energy consumption and system weight compared to conventional actuator-based solutions. Dynamic control is applied to adjust the level of support according to the wearer’s lumbar motion, using an inertial measurement unit (IMU) to regulate intra-abdominal pressure (IAP) and enhance spinal stability. The concept of the neutral zone (NZ) is incorporated to define the operational range, such that the clutch remains disengaged within the NZ where assistance is unnecessary and engages outside the NZ to provide appropriate support. Experiments conducted on a dummy model simulating human lumbar motion demonstrate the effectiveness of the proposed device in modulating abdominal pressure and delivering adaptive lumbar support, indicating its potential as an effective alternative to conventional lumbar braces.},
  author={Lee, Garam and Sung, Eunho and Kim, Joowan and Park, Jaeheung and Kim, Keewon},
  journal={International Journal of Control, Automation and Systems},
  year={2025},
  volume={23},
  number={2},
  pages={370--381},
  publisher={Springer Nature},
  doi={https://doi.org/10.1007/s12555-024-0518-8}
}

@article{Kernel2025moon,
  abbr={RobotHand},
  bibtex_show={true},
  title={Kernel PCA-Based Hand Synergy for Efficient Robot Hand Teleoperation Using Glove Interface},
  abstract = {Accurate sensing equipment for capturing human hand data is crucial for robot hand teleoperation. Individual calibration processes to reflect anatomical differences in human hands are complex and time-consuming. Additionally, handling noise caused by slipping or impact while wearing sensing equipment is challenging. This paper proposes an efficient calibration system integrating Kernel Principal Component Analysis (Kernel PCA) with hand synergy to overcome these limitations. By utilizing Kernel PCA, the proposed approach enables the reconstruction of both object-grasping and non-grasping hand postures based on human hand synergy. The accuracy of the reconstructed hand postures is evaluated using four principal components (PCs) and comparing data from five different users. The proposed method improves accuracy and reduces standard deviation compared to traditional hand synergy using Principal Component Analysis (PCA). Kernel PCA demonstrates high robustness to noise from sensing equipment, ensuring reliable hand posture reproduction under various conditions. The application of this system to an actual robot hand verifies its practical utility, providing reliable control across various users and scenarios.},
  author={Seongkyeong Moon and Sung, Eunho and Jaeheung Park},
  journal={2024 IEEE-RAS 23rd International Conference on Humanoid Robots (Humanoids)},
  year={2024},
  pages={17-23},
  doi={10.1109/Humanoids58906.2024.10769864},
  preview={Pub_Th_KPCA.png},
  publisher={IEEE}
}

@article{kim2024preliminary,
  abbr={Haptic},
  bibtex_show={true},
  title={Preliminary Study and Analysis of MUAT: Modularized Ultralight Arm Tracker for Humanoid Teleoperation},
  abstract = {This research addresses the need for advanced teleoperation in challenging environments where human access is limited, introducing MUAT (Modularized Ultralight Arm Tracker). Leveraging advancements in humanoid robotics and motion retargeting, MUAT creatively overcomes the limitations of previous teleoperation methods, including IMU-based and optical sensor-based systems, which often struggled with issues related to measurement accuracy, space requirements, and operational constraints. MUAT employs a position sensor-based exoskeleton approach, offering a novel solution. Its lightweight and modular construction allows the device to be easily attached to an operator's forearm, minimizing movement interference and enabling unrestricted hand use. To assess feasibility and effectiveness, a preliminary version called p-MUAT (preliminary MUAT) was developed. Through rigorous testing with p-MUAT, the device demonstrated high precision in tracking wrist position, validated using a motion capture system. Furthermore, the study confirmed MUAT's capability to effectively teleoperate a humanoid robot, highlighting its practical potential for real-world teleoperation applications.},
  author={Kim, Dongjun and Kim, Juhyun and You, Seungbin and Sung, Eunho and Park, Jaeheung},
  journal={2024 21st International Conference on Ubiquitous Robots (UR)},
  pages={635-641},
  year={2024},
  doi={10.1109/UR61395.2024.10597497},
  preview={Pub_Th_Muat.png},
  publisher={IEEE}
}

@article{lee2023walking,
  abbr={State Estimation},
  bibtex_show={true},
  title={Walking State Estimation for Biped Robot Using Foot Contact Information},
  abstract = {Contact information plays a crucial role in many robotic applications. In bipedal walking, the CoP--ZMP criterion, computed from the contact wrench between the foot and the ground, is an essential measure of stability. However, this criterion requires an accurate estimation of the contact point to define the support polygon, which becomes challenging on uneven terrain. To address this limitation, this paper proposes a support-polygon-independent estimation framework that recognizes the current walking state (WS) using contact information. The framework consists of two indicators and one discriminator: the indicators use Gaussian Mixture Models to represent sub-states for each input, while the discriminator determines the current WS based on rule-based decision making. The proposed framework is validated through simulations and experiments on a full-size humanoid robot, TOCABI.},
  author={Lee, Haeseong and Kim, Myeong-Ju and Sung, Eunho and Park, Jaeheung},
  journal={International Conference on Intelligent Autonomous Systems},
  pages={521--535},
  year={2023},
  award={Best Paper Award Runner-up}, 
  award_name={Best Paper Award Runner-up},
  doi={https://doi.org/10.1007/978-3-031-44851-5_40},
  organization={Springer}
}

@article{kim2023disturbance,
  abbr={Biped Walking},
  bibtex_show={true},
  title={Disturbance adapting walking pattern generation using capture point feedback considering CoM control performance},
  abstract = {To enable humanoid robots to walk in complex environments, a robust walking pattern capable of responding to disturbances is essential. ZMP-based walking pattern generation is widely used, as it produces a center of mass (CoM) trajectory that places the ZMP within the robot's support polygon. However, tracking a predefined reference ZMP often limits disturbance recovery. To address this issue, capture-point (CP)-based approaches were introduced for improved robustness, typically by controlling the robot to track a reference CP. In this study, we adopt a method that updates the reference ZMP using CP feedback, previously explored in a ZMP-based preview control framework considering CoM tracking performance. We derive the stability analysis of the proposed approach and provide its physical interpretation. The method is implemented on the humanoid robot DYROS-JET, demonstrating enhanced robustness against disturbances.},
  author={Kim, Myeong-Ju and Kim, Mingon and Lim, Daegyu and Sung, Eunho and Park, Jaeheung},
  journal={Journal of Intelligent \& Robotic Systems},
  volume={108},
  number={2},
  pages={22},
  year={2023},
  doi={https://doi.org/10.1007/s10846-023-01870-x},
  publisher={Springer}
}

@article{kim2023arc,
  abbr={RobotHand},
  bibtex_show={true},
  title={ARC joint: Anthropomorphic rolling contact joint with kinematically variable torsional stiffness},
  abstract = {Compliant joints are widely used in end-effectors because they compensate for the lack of actuated degrees of freedom in under-actuated systems, enhance grasp stability, and protect mechanisms from unexpected contacts. However, while compliance improves power grasping, it can reduce the success rate of pinch grasps when fingers wrap around large objects, limiting stability in fingertip-based manipulation of small items. To address this limitation, we propose an anthropomorphic rolling contact joint inspired by human finger structures, including the tongue-and-groove geometry and collateral ligaments. This joint passively adjusts its torsional stiffness according to the joint angle without requiring additional weight or space. As a result, flexing the fingers for pinch grasping increases torsional stiffness and improves grasp stability. In this study, the characteristics and performance of the anthropomorphic rolling contact joint are experimentally analyzed by varying the tongue-and-groove shape. Furthermore, we demonstrate that a three-finger gripper utilizing joints with higher torsional stiffness can reliably grasp small objects in pinch-grasp postures. Owing to its simple fabrication, the joint also offers advantages in maintainability.},
  author={Kim, Seungyeon and Sung, Eunho and Park, Jaeheung},
  journal={IEEE Robotics and Automation Letters},
  volume={8},
  number={3},
  pages={1810--1817},
  year={2023},
  preview={Pub_Th_ARC.gif},
  doi={10.1109/LRA.2023.3243439},
  video = {https://www.youtube.com/embed/pzf1MEUVxr0},
  publisher={IEEE}
}

@article{you2022plate,
  abbr={Reducer},
  bibtex_show={true},
  title={Plate Harmonic Reducer with a Profiled Groove Wave Generator},
  abstract = {This study introduces a mechanism that realizes a novel structural form of the harmonic reducer. Conventional robots commonly employ mechanical reducers to compensate for the low-torque, high-speed characteristics of electric motors, with harmonic reducers widely favored for their compactness and backlash-free precision. The plate harmonic reducer, which preserves the topology and reduction principle of a conventional harmonic reducer, is a new type of strain gear that deforms axially into a plate-like structure. Due to its morphological characteristics, it exhibits unique properties in axial thickness, torsional stiffness, and efficiency. This paper presents the reduction principle of the plate harmonic reducer, details methodological solutions for its realization, and analyzes its theoretical performance improvements and operational feasibility through finite element analysis and a 3D-printed prototype.},
  author={You, Seungbin and Jung, Jaesug and Sung, Eunho and Park, Jaeheung},
  journal={2022 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  pages={1900--1907},
  year={2022},
  doi={10.1109/IROS47612.2022.9981317},
  organization={IEEE}
}

@article{kim2022avatar,
  abbr={RobotHand},
  bibtex_show={true},
  title={3-Finger Robotic Hand and Hand Posture Mapping Algorithm for Avatar Robot},
  abstract = {Avatar robots aim to provide users with an immersive sense of embodiment, enabling intuitive and natural task execution through teleoperation. Although a human-like end-effector is desirable for such systems, a robotic hand that fully matches human hand performance has not yet been realized. In this paper, we propose a new three-finger robotic hand and a human-avatar hand posture mapping algorithm integrated into the TOCABI-AVATAR teleoperation system. The finger design incorporates flexible rolling contact joints and a tendon-driven mechanism, allowing adaptive grasping and passive absorption of impact forces from unexpected contacts. Moreover, a hand-mapping algorithm based on five calibration postures compensates for the physical differences among operators. Using the proposed robotic hand and mapping method, operators can perform 13 of the 16 grasp types in a standard grasp taxonomy as well as four hand gestures. The system was also demonstrated in the ANA Avatar XPRIZE Semi-final, successfully executing scenarios involving both object manipulation and social interaction.},
  author={Kim, Seungyeon and Sung, Eunho and Park, Jaeheung},
  journal={Journal of Korea Robotics Society },
  volume={17},
  number={3},
  pages={322--333},
  year={2022},
  preview={Pub_Th_finger3.png},
  doi={10.7746/jkros.2022.17.3.322},
  award      = {https://kros.org/intro/sub_intro05_1.asp}, 
  award_name={Best Paper Award}
}

@inproceedings{park2022team,
  abbr={Avatar},
  bibtex_show={true},
  title={Team SNU's avatar system for teleoperation using humanoid robot: ANA Avatar XPRIZE competition},
  abstract = {In this paper, we present an avatar system that uses a human-like robot capable of naturally mimicking human motion. The system, developed for the ANA Avatar XPRIZE competition, consists of a master station and the humanoid robot TOCABI. The master station enables an operator to see and hear through the robot while remotely controlling it from a separate location. The robot manipulates objects, moves according to the operator’s actions, and facilitates interaction with recipients. We describe the components of the system and discuss potential improvements.},
  author={Park, Beomyeong and Jung, Jaesug and Sim, Jaehoon and Kim, S and Ahn, J and Lim, Daegyu and Kim, Donghyeon and Kim, Myeongju and Park, Suhan and Sung, Eunho and Hokyun Lee and Gyeongjae Park and Junhyeok Cha and Jaeyong Shin and Mathew Schwartz and Park, Jaeheung},
  journal={RSS 2022 workshop on “towards robot avatars: perspectives on the ANA avatar XPRIZE competition},
  preview={Pub_Th_avatar_sm.png},
  year={2022}
}

@article{park2021whole,
  abbr={Biped Walking},
  bibtex_show={true},
  title={Whole-body walking pattern using pelvis-rotation for long stride and arm swing for yaw angular momentum compensation},
  abstract = {A long stride allows a humanoid robot to achieve faster and more stable walking. To realize long-stride walking, the robot’s kinematic range must be fully utilized, and incorporating pelvic rotation is one effective approach. However, when the pelvis rotates during long-stride walking, the resulting yaw momentum can become larger than that of walking with a fixed pelvis, potentially destabilizing the robot. In this paper, we propose controlling the robot’s lower body as a redundant system composed of the leg joints and a waist joint to enable pelvis-rotation walking. We also introduce a method for defining the base frame position to realize this redundancy. Furthermore, a quadratic programming (QP) controller is formulated to generate arm swing for yaw momentum compensation while simultaneously controlling lower-body motion. The feasibility of the proposed method is validated through simulations and experiments demonstrating long-stride walking with pelvic rotation and yaw momentum compensation via arm swing.},
  author={Park, Beomyeong and Kim, Myeong-Ju and Sung, Eunho and Kim, Junhyung and Park, Jaeheung},
  journal={2020 IEEE-RAS 20th International Conference on Humanoid Robots (Humanoids)},
  pages={47--52},
  year={2021},
  doi={10.1109/HUMANOIDS47582.2021.9555794},
  organization={IEEE}
}

@article{you2021development,
  abbr={Reducer},
  bibtex_show={true},
  title={Development of harmonic reducing transmission for legged robots},
  abstract = {Transmission mechanisms such as belts and linkages are commonly used in quadruped robots to reduce inertia, while reduction mechanisms including harmonic and planetary reducers are employed to achieve the high torque required for legged locomotion. Harmonic reducers, in particular, are widely adopted due to their high reduction ratio and compact form factor. By integrating reduction and transmission mechanisms, lightweight and compact leg designs can be achieved through reductions in volume and mass. In this study, we propose a novel mechanism that combines a harmonic reducer with belt-pulley transmission units to further decrease the weight and volume of legged robots. The working principles of the mechanism are presented, and its effectiveness is verified using a 3D-printed testbed equipped with encoders. Experimental results confirm the feasibility of the proposed mechanism, and the findings are discussed from both theoretical and practical perspectives.},
  author={You, Seungbin and Sim, Jaehoon and Kim, Seungyeon and Sung, Eunho and Park, Jaeheung},
  journal={2021 18th International Conference on Ubiquitous Robots (UR)},
  pages={239--243},
  year={2021},
  doi={10.1109/UR52253.2021.9494649},
  preview={Pub_Th_ur.gif},
  organization={IEEE}
}
